+    /// All groups share ONE 20 ms deadline. No retry and no partial-frame acceptance.
+    fn fifo_bounded_telemetry(&mut self, ids: &[u8]) -> Result<BTreeMap<u8, Vec<u8>>> {
+        sync_read_packet(SYNC_ADDRESS, SYNC_LENGTH, ids)?;
+        let started = Instant::now();
+        let deadline = started + Duration::from_millis(TELEMETRY_DEADLINE_MS);
+        let mut combined = SyncTrace { address: SYNC_ADDRESS, length: SYNC_LENGTH,
+            request_sent: true, ..SyncTrace::default() };
+        let mut replies = BTreeMap::new();
+        for (index, group) in ids.chunks(3).enumerate() {
+            let result = self.sync_read_window(SYNC_ADDRESS, SYNC_LENGTH, group, false,
+                Some((started, deadline)), false);
+            let trace = &self.last_sync;
+            combined.rx_bytes += trace.rx_bytes;
+            combined.bad_checksums += trace.bad_checksums;
+            combined.discarded += trace.discarded;
+            combined.request_sent &= trace.request_sent;
+            combined.deadline_exceeded |= trace.deadline_exceeded;
+            combined.complete_but_late |= trace.complete_but_late;
+            combined.elapsed_us = started.elapsed().as_micros() as u64;
