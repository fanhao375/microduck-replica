+//! Per-board flat-field chroma correction for the I420 VIN output.
+
+use anyhow::{Context, Result, ensure};
+use std::path::Path;
+
+const MAGIC: &[u8; 8] = b"MVIDWB01";
+const HEADER_LEN: usize = 16;
+const MAX_OFFSET: i16 = 8;
+
+pub(super) struct WhiteMap {
+    offsets: Vec<u8>,
+    chroma_len: usize,
+}
+
+impl WhiteMap {
+    pub(super) fn load(path: &Path, width: u32, height: u32) -> Result<Self> {
+        ensure!(
+            path.is_absolute(),
+            "MEDIAD_VIN_WHITE_MAP must be an absolute file path"
+        );
+        let chroma_len = (width as usize)
+            .checked_mul(height as usize)
+            .map(|pixels| pixels / 4)
+            .context("VIN white map dimensions overflow")?;
+        let expected_len = HEADER_LEN + chroma_len * 2;
+        let metadata = std::fs::metadata(path).context("cannot inspect MEDIAD_VIN_WHITE_MAP")?;
+        ensure!(
+            metadata.is_file(),
+            "MEDIAD_VIN_WHITE_MAP must be a regular file"
+        );
+        ensure!(
+            metadata.len() == expected_len as u64,
+            "MEDIAD_VIN_WHITE_MAP size mismatch"
+        );
+        let data = std::fs::read(path).context("cannot read MEDIAD_VIN_WHITE_MAP")?;
+        ensure!(&data[..8] == MAGIC, "MEDIAD_VIN_WHITE_MAP magic mismatch");
+        ensure!(
+            u32::from_le_bytes(data[8..12].try_into()?) == width,
+            "MEDIAD_VIN_WHITE_MAP width mismatch"
+        );
+        ensure!(
+            u32::from_le_bytes(data[12..16].try_into()?) == height,
+            "MEDIAD_VIN_WHITE_MAP height mismatch"
+        );
+        let offsets = data[HEADER_LEN..].to_vec();
+        ensure!(
+            offsets
+                .iter()
+                .all(|value| (*value as i8 as i16).abs() <= MAX_OFFSET),
+            "MEDIAD_VIN_WHITE_MAP correction exceeds safe limit"
+        );
+        Ok(Self {
+            offsets,
+            chroma_len,
+        })
+    }
+
+    pub(super) fn apply(&self, frame: &mut [u8]) {
+        let luma_len = self.chroma_len * 4;
+        let (u, v) = frame[luma_len..].split_at_mut(self.chroma_len);
+        for (&pair, pixel) in self.offsets.iter().step_by(2).zip(u) {
+            *pixel = pixel.saturating_add_signed(pair as i8);
+        }
+        for (&pair, pixel) in self.offsets.iter().skip(1).step_by(2).zip(v) {
+            *pixel = pixel.saturating_add_signed(pair as i8);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn corrects_only_chroma_and_clamps_overflow() {
+        let map = WhiteMap {
+            offsets: vec![2, 253, 1, 255],
+            chroma_len: 2,
+        };
+        let mut frame = vec![80; 8];
+        frame.extend([127, 255, 129, 0]);
+        map.apply(&mut frame);
+        assert_eq!(&frame[..8], &[80; 8]);
+        assert_eq!(&frame[8..], &[129, 255, 126, 0]);
+    }
+}
