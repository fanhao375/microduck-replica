@@ -0,0 +1,678 @@
+//! Allwinner capture through the board's GStreamer 1.18, behind the existing demand owner.
+//!
+//! The source stays NULL until Capture activates it. A weak reference and bounded poll keep
+//! the helper tied to that lifetime, including a camera which never delivers its first frame.
+use std::ffi::OsString;
+use std::io::{self, Read};
+use std::os::fd::AsRawFd;
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+
+#[path = "vin_white_balance.rs"]
+mod white_balance;
+use white_balance::WhiteMap;
+
+const POLL_INTERVAL: Duration = Duration::from_millis(50);
+
+#[derive(Clone, Copy)]
+struct Timing {
+    first_frame: Duration,
+    next_frame: Duration,
+    retry: Duration,
+}
+
+impl Default for Timing {
+    fn default() -> Self {
+        Self {
+            first_frame: Duration::from_secs(5),
+            next_frame: Duration::from_secs(2),
+            retry: Duration::from_secs(1),
+        }
+    }
+}
+
+trait Consumer {
+    /// None means the owning source was destroyed; false means demand is asleep.
+    fn active(&self) -> Option<bool>;
+    fn push(&self, frame: Vec<u8>) -> bool;
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn source(
+    device: &str,
+    width: u32,
+    height: u32,
+    fps: u32,
+) -> anyhow::Result<gstreamer::Element> {
+    use anyhow::{Context, ensure};
+    use gst::prelude::*;
+    use gstreamer as gst;
+    use gstreamer_app as gst_app;
+
+    ensure!(
+        width > 0 && height > 0 && width % 2 == 0 && height % 2 == 0 && fps > 0,
+        "VIN requires even, nonzero I420 dimensions and a nonzero frame rate"
+    );
+    let frame_len = (width as usize)
+        .checked_mul(height as usize)
+        .and_then(|n| n.checked_mul(3))
+        .map(|n| n / 2)
+        .context("VIN frame size overflow")?;
+    let profile = isp_profile(std::env::var_os("MEDIAD_VIN_ISP_PROFILE"))?;
+    let white_map = std::env::var_os("MEDIAD_VIN_WHITE_MAP")
+        .map(|path| WhiteMap::load(Path::new(&path), width, height))
+        .transpose()?;
+    tracing::info!(isp_profile = profile.is_some(), "VIN ISP profile selection");
+    tracing::info!(
+        white_map = white_map.is_some(),
+        "VIN white balance map selection"
+    );
+    let caps = gst::Caps::builder("video/x-raw")
+        .field("format", "I420")
+        .field("width", width as i32)
+        .field("height", height as i32)
+        .field("framerate", gst::Fraction::new(fps as i32, 1))
+        .field("pixel-aspect-ratio", gst::Fraction::new(1, 1))
+        .field("colorimetry", "bt709")
+        .field("chroma-site", "mpeg2")
+        .build();
+    let source = gst_app::AppSrc::builder()
+        .caps(&caps)
+        .is_live(true)
+        .do_timestamp(true)
+        .format(gst::Format::Time)
+        // Demand transitions can race the final frame; keep that race bounded to two frames.
+        .max_buffers(2)
+        .max_bytes((frame_len * 2) as u64)
+        .leaky_type(gst_app::AppLeakyType::Downstream)
+        .build();
+    struct AppConsumer(glib::WeakRef<gst_app::AppSrc>, Option<WhiteMap>);
+    impl Consumer for AppConsumer {
+        fn active(&self) -> Option<bool> {
+            self.0.upgrade().map(|source| {
+                matches!(
+                    source.current_state(),
+                    gst::State::Paused | gst::State::Playing
+                )
+            })
+        }
+        fn push(&self, mut frame: Vec<u8>) -> bool {
+            let Some(source) = self.0.upgrade() else {
+                return false;
+            };
+            if let Some(map) = &self.1 {
+                map.apply(&mut frame);
+            }
+            match source.push_buffer(gst::Buffer::from_mut_slice(frame)) {
+                Ok(_) => true,
+                Err(gst::FlowError::Flushing) => false,
+                Err(error) => {
+                    tracing::warn!(%error, "VIN frame delivery stopped; capture will retry");
+                    false
+                }
+            }
+        }
+    }
+    let consumer = AppConsumer(source.downgrade(), white_map);
+    let device = device.to_owned();
+    std::thread::Builder::new()
+        .name("vin-gst18".into())
+        .spawn(move || {
+            supervise(
+                consumer,
+                || capture_command(&device, width, height, fps, profile.as_deref()),
+                frame_len,
+                Timing::default(),
+            )
+        })
+        .context("could not start VIN capture owner")?;
+    Ok(source.upcast())
+}
+
+fn isp_profile(value: Option<OsString>) -> anyhow::Result<Option<PathBuf>> {
+    use anyhow::{Context, ensure};
+    use std::os::unix::ffi::OsStrExt;
+    let Some(value) = value else {
+        return Ok(None);
+    };
+    let path = PathBuf::from(value);
+    ensure!(
+        path.is_absolute(),
+        "MEDIAD_VIN_ISP_PROFILE must be an absolute file path"
+    );
+    // LD_PRELOAD treats whitespace and ':' as a library-list separator, even inside quotes.
+    ensure!(
+        !path
+            .as_os_str()
+            .as_bytes()
+            .iter()
+            .any(|byte| byte.is_ascii_whitespace() || *byte == b':'),
+        "MEDIAD_VIN_ISP_PROFILE must not contain whitespace or ':'"
+    );
+    ensure!(
+        std::fs::metadata(&path)
+            .context("cannot inspect MEDIAD_VIN_ISP_PROFILE")?
+            .is_file(),
+        "MEDIAD_VIN_ISP_PROFILE must refer to an existing regular file"
+    );
+    std::fs::File::open(&path).context("cannot read MEDIAD_VIN_ISP_PROFILE")?;
+    Ok(Some(path))
+}
+
+fn capture_command(
+    device: &str,
+    width: u32,
+    height: u32,
+    fps: u32,
+    profile: Option<&Path>,
+) -> Command {
+    let mut command = frame_command("/usr/bin/gst-launch-1.0", profile);
+    command.args([
+        "-q", "v4l2src", &format!("device={device}"), "io-mode=mmap",
+        "en-awisp=1", "en-largemode=0", "do-timestamp=true", "!",
+        // VIN reports RGB24 but delivers BGR bytes; its NV12 output has displaced chroma.
+        // Rebuild buffers and VideoMeta as BGR: capssetter alone leaves conflicting RGB meta.
+        "video/x-raw,format=RGB,width=1280,height=960,framerate=30/1,pixel-aspect-ratio=1/1",
+        "!", "rawvideoparse", "format=bgr", "width=1280", "height=960",
+        "framerate=30/1", "use-sink-caps=false", "disable-passthrough=true", "colorimetry=sRGB",
+        // Drop before the CPU conversion/scaling when the requested output is 15 fps.
+        "!", "videorate", "drop-only=true", "!",
+        &format!("video/x-raw,format=BGR,framerate={fps}/1"),
+        "!", "videoconvert", "!", "videoscale", "add-borders=true", "!",
+        &format!("video/x-raw,format=I420,width={width},height={height},framerate={fps}/1,pixel-aspect-ratio=1/1,colorimetry=bt709,chroma-site=mpeg2"),
+        "!", "fdsink", "fd=3", "sync=false",
+    ])
+    .env_remove("LD_LIBRARY_PATH").env_remove("GST_PLUGIN_PATH")
+    .env_remove("GST_PLUGIN_PATH_1_0").env_remove("GST_DEBUG")
+    .env("GST_PLUGIN_SYSTEM_PATH_1_0", "/usr/lib/aarch64-linux-gnu/gstreamer-1.0")
+    .env("GST_PLUGIN_SCANNER_1_0", "/usr/lib/aarch64-linux-gnu/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner")
+    .env("GST_PLUGIN_SCANNER", "/usr/lib/aarch64-linux-gnu/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner")
+    .env("GST_REGISTRY_1_0", "/var/lib/mediad/gst18-vin-registry.bin")
+    .env("XDG_RUNTIME_DIR", "/run/mediad");
+    command
+}
+
+fn frame_command(program: &str, profile: Option<&Path>) -> Command {
+    // The vendor ISP uses printf(stdout), including while streaming. Reserve fd 3 for
+    // fdsink before moving ordinary stdout to stderr; exec preserves the helper's PID.
+    // All dynamic values stay separate argv entries, never interpolated shell source.
+    let mut command = Command::new("/bin/sh");
+    command.args([
+        "-c",
+        "exec 3>&1; exec 1>&2; profile=$1; shift; if [ -n \"$profile\" ]; then export LD_PRELOAD=\"$profile\"; fi; exec \"$@\"",
+        "vin-capture",
+    ]);
+    // Assign inside the already-running shell: the profile loads only in gst-launch,
+    // never into mediad or the shell used to isolate the vendor's stdout.
+    command
+        .arg(profile.map(Path::as_os_str).unwrap_or_default())
+        .arg(program);
+    command
+}
+
+fn supervise(
+    consumer: impl Consumer,
+    command: impl Fn() -> Command,
+    frame_len: usize,
+    timing: Timing,
+) {
+    loop {
+        match consumer.active() {
+            None => return,
+            Some(false) => {
+                std::thread::sleep(POLL_INTERVAL);
+                continue;
+            }
+            Some(true) => {}
+        }
+        if let Err(error) = capture(&consumer, command(), frame_len, timing) {
+            // Keep argv out of logs; the bounded stderr reader records pipeline diagnostics.
+            tracing::warn!(%error, "VIN capture stopped; retrying while requested");
+        }
+        let until = Instant::now() + timing.retry;
+        while Instant::now() < until {
+            if consumer.active() != Some(true) {
+                break;
+            }
+            std::thread::sleep(POLL_INTERVAL);
+        }
+    }
+}
+
+/// Own the child and its stderr reader together: every exit path kills, reaps, and joins.
+struct Session {
+    child: Child,
+    stop: Arc<AtomicBool>,
+    stderr: Option<std::thread::JoinHandle<()>>,
+}
+
+impl Drop for Session {
+    fn drop(&mut self) {
+        // Let gst-launch set its pipeline NULL and release the vendor ISP before SIGKILL.
+        // A stalled driver still cannot hold the demand owner indefinitely.
+        let _ = unsafe { libc::kill(self.child.id() as libc::pid_t, libc::SIGINT) };
+        let until = Instant::now() + Duration::from_millis(400);
+        while Instant::now() < until {
+            match self.child.try_wait() {
+                Ok(Some(_)) => break,
+                Ok(None) => std::thread::sleep(Duration::from_millis(10)),
+                Err(_) => break,
+            }
+        }
+        let _ = self.child.kill();
+        match self.child.wait() {
+            Ok(status) => tracing::debug!(%status, "VIN helper reaped"),
+            Err(error) => tracing::warn!(%error, "VIN helper wait failed"),
+        }
+        self.stop.store(true, Ordering::Relaxed);
+        if let Some(reader) = self.stderr.take() {
+            let _ = reader.join();
+        }
+    }
+}
+
+fn capture(
+    consumer: &impl Consumer,
+    mut command: Command,
+    frame_len: usize,
+    timing: Timing,
+) -> io::Result<()> {
+    let child = command
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()?;
+    let mut session = Session {
+        child,
+        stop: Arc::new(AtomicBool::new(false)),
+        stderr: None,
+    };
+    let mut stdout = session
+        .child
+        .stdout
+        .take()
+        .ok_or_else(|| io::Error::other("VIN helper has no stdout"))?;
+    nonblocking(&stdout)?;
+    if let Some(mut stderr) = session.child.stderr.take() {
+        nonblocking(&stderr)?;
+        let stop = session.stop.clone();
+        session.stderr = Some(
+            std::thread::Builder::new()
+                .name("vin-stderr".into())
+                .spawn(move || drain_stderr(&mut stderr, &stop))?,
+        );
+    }
+    tracing::info!("VIN capture helper started");
+    let result = (|| {
+        let mut timeout = timing.first_frame;
+        while consumer.active() == Some(true) {
+            let mut frame = vec![0; frame_len];
+            if !read_frame(&mut stdout, &mut frame, timeout, || {
+                consumer.active() == Some(true)
+            })? {
+                break;
+            }
+            if !consumer.push(frame) {
+                break;
+            }
+            timeout = timing.next_frame;
+        }
+        Ok(())
+    })();
+    // Keep stdout open until the helper has stopped, so cancellation is SIGINT rather than EPIPE.
+    drop(session);
+    result
+}
+
+fn nonblocking(pipe: &impl AsRawFd) -> io::Result<()> {
+    // The descriptors are owned pipes. Preserve existing flags, then poll before every read.
+    let flags = unsafe { libc::fcntl(pipe.as_raw_fd(), libc::F_GETFL) };
+    if flags < 0
+        || unsafe { libc::fcntl(pipe.as_raw_fd(), libc::F_SETFL, flags | libc::O_NONBLOCK) } < 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+fn poll(pipe: &impl AsRawFd) -> io::Result<()> {
+    let mut fd = libc::pollfd {
+        fd: pipe.as_raw_fd(),
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    if unsafe { libc::poll(&mut fd, 1, POLL_INTERVAL.as_millis() as i32) } < 0 {
+        let error = io::Error::last_os_error();
+        if error.kind() != io::ErrorKind::Interrupted {
+            return Err(error);
+        }
+    }
+    Ok(())
+}
+
+fn read_frame(
+    pipe: &mut (impl Read + AsRawFd),
+    frame: &mut [u8],
+    timeout: Duration,
+    active: impl Fn() -> bool,
+) -> io::Result<bool> {
+    let deadline = Instant::now() + timeout;
+    let mut read = 0;
+    while read < frame.len() {
+        if !active() {
+            return Ok(false);
+        }
+        if Instant::now() >= deadline {
+            return Err(io::Error::new(io::ErrorKind::TimedOut, "VIN frame timeout"));
+        }
+        match pipe.read(&mut frame[read..]) {
+            Ok(0) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::UnexpectedEof,
+                    "VIN helper closed its frame pipe",
+                ));
+            }
+            Ok(bytes) => read += bytes,
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => poll(pipe)?,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(true)
+}
+
+fn drain_stderr(pipe: &mut (impl Read + AsRawFd), stop: &AtomicBool) {
+    let mut buffer = [0u8; 512];
+    let mut line = Vec::with_capacity(512);
+    let mut errors = 0;
+    let mut banners = 0;
+    while !stop.load(Ordering::Relaxed) {
+        match pipe.read(&mut buffer) {
+            Ok(0) => {
+                log_stderr(&line, &mut errors, &mut banners);
+                return;
+            }
+            Ok(bytes) => {
+                for byte in &buffer[..bytes] {
+                    if *byte == b'\n' {
+                        log_stderr(&line, &mut errors, &mut banners);
+                        line.clear();
+                    } else if line.len() < 512 {
+                        line.push(*byte);
+                    }
+                }
+            }
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                if poll(pipe).is_err() {
+                    return;
+                }
+            }
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+            Err(_) => return,
+        }
+    }
+}
+
+fn log_stderr(line: &[u8], errors: &mut usize, banners: &mut usize) {
+    let detail = String::from_utf8_lossy(line);
+    let detail = detail.trim();
+    if detail.is_empty() {
+        return;
+    }
+    let lower = detail.to_ascii_lowercase();
+    // The helper has no credentials in its argv; still do not forward credential-like output.
+    let detail = if ["password", "token", "secret", "authorization", "credential"]
+        .iter()
+        .any(|word| lower.contains(word))
+    {
+        "[credential-like diagnostic redacted]"
+    } else {
+        detail
+    };
+    if ["error", "isp_err", "failed", "warning"]
+        .iter()
+        .any(|word| lower.contains(word))
+    {
+        if *errors < 8 {
+            tracing::warn!(detail, "VIN helper diagnostic");
+            *errors += 1;
+        }
+    } else if *banners < 4 {
+        tracing::debug!(detail, "VIN helper initialization");
+        *banners += 1;
+    }
+}
