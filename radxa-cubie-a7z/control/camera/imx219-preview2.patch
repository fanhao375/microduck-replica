+
+    struct State {
+        alive: AtomicBool,
+        active: AtomicBool,
+        frames: AtomicUsize,
+        launches: AtomicUsize,
+    }
+    struct FakeConsumer(Arc<State>);
+    impl Consumer for FakeConsumer {
+        fn active(&self) -> Option<bool> {
+            self.0
+                .alive
+                .load(Ordering::SeqCst)
+                .then(|| self.0.active.load(Ordering::SeqCst))
+        }
+        fn push(&self, frame: Vec<u8>) -> bool {
+            assert_eq!(frame, b"abcdefghijkl");
+            if self.active() != Some(true) {
+                return false;
+            }
+            self.0.frames.fetch_add(1, Ordering::SeqCst);
+            true
+        }
+    }
+
+    struct Rig {
+        state: Arc<State>,
+        owner: Option<std::thread::JoinHandle<()>>,
+    }
+    const WRITER: &str = "while True:\n sys.stdout.buffer.write(b'abcdefghijkl'); sys.stdout.buffer.flush(); time.sleep(.02)\n";
+    impl Rig {
+        fn new(first: &'static str) -> Self {
+            Self::with_frame_pipe(first, false)
+        }
+        fn with_frame_pipe(first: &'static str, dedicated: bool) -> Self {
+            let state = Arc::new(State {
+                alive: AtomicBool::new(true),
+                active: AtomicBool::new(false),
+                frames: AtomicUsize::new(0),
+                launches: AtomicUsize::new(0),
+            });
+            let owner_state = state.clone();
+            let consumer = FakeConsumer(state.clone());
+            let owner = std::thread::spawn(move || {
+                supervise(
+                    consumer,
+                    || {
+                        let attempt = owner_state.launches.fetch_add(1, Ordering::SeqCst);
+                        let mut command = if dedicated {
+                            frame_command("python3", None)
+                        } else {
+                            Command::new("python3")
+                        };
+                        let script = format!(
+                            "import os,sys,time\n{}",
+                            if attempt == 0 { first } else { WRITER }
+                        );
+                        command.args(["-u", "-c", &script]);
+                        command
+                    },
+                    12,
+                    Timing {
+                        first_frame: Duration::from_millis(600),
+                        next_frame: Duration::from_millis(200),
+                        retry: Duration::from_millis(50),
+                    },
+                )
+            });
+            Self {
+                state,
+                owner: Some(owner),
+            }
+        }
+        fn wait(&self, condition: impl Fn() -> bool) {
+            let until = Instant::now() + Duration::from_secs(4);
+            while !condition() && Instant::now() < until {
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            assert!(
+                condition(),
+                "VIN supervisor did not reach the expected state"
+            );
+        }
+        fn frames(&self) -> usize {
+            self.state.frames.load(Ordering::SeqCst)
+        }
+        fn launches(&self) -> usize {
+            self.state.launches.load(Ordering::SeqCst)
+        }
+    }
+    impl Drop for Rig {
+        fn drop(&mut self) {
+            self.state.alive.store(false, Ordering::SeqCst);
+            self.state.active.store(false, Ordering::SeqCst);
+            self.owner.take().unwrap().join().unwrap();
+        }
+    }
+
+    #[test]
+    fn no_demand_stays_asleep_and_three_rejoins_deliver_new_frames() {
+        let rig = Rig::new(WRITER);
+        std::thread::sleep(Duration::from_millis(150));
+        assert_eq!(rig.launches(), 0);
+        assert_eq!(rig.frames(), 0);
+        for round in 1..=3 {
+            let before = rig.frames();
+            rig.state.active.store(true, Ordering::SeqCst);
+            rig.wait(|| rig.frames() >= before + 2);
+            assert_eq!(rig.launches(), round);
+            rig.state.active.store(false, Ordering::SeqCst);
+            std::thread::sleep(Duration::from_millis(150));
+            let asleep = rig.frames();
+            std::thread::sleep(Duration::from_millis(100));
+            assert_eq!(rig.frames(), asleep);
+        }
+    }
+
+    #[test]
+    fn partial_frame_eof_restarts_without_delivering_corrupt_pixels() {
+        let rig = Rig::new("sys.stdout.buffer.write(b'abcdef'); sys.stdout.buffer.flush()\n");
+        rig.state.active.store(true, Ordering::SeqCst);
+        rig.wait(|| rig.frames() >= 2);
+        assert!(rig.launches() >= 2);
+    }
+
+    #[test]
+    fn first_frame_and_interframe_timeouts_restart_the_helper() {
+        for first in [
+            "time.sleep(60)\n",
+            "sys.stdout.buffer.write(b'abcdefghijkl'); sys.stdout.buffer.flush(); time.sleep(60)\n",
+        ] {
+            let rig = Rig::new(first);
+            rig.state.active.store(true, Ordering::SeqCst);
+            rig.wait(|| rig.launches() >= 2 && rig.frames() >= 3);
+        }
+    }
+
+    #[test]
+    fn a_full_stderr_pipe_cannot_block_video_or_cancellation() {
+        let rig = Rig::new(
+            "sys.stderr.buffer.write(b'x' * 1000000); sys.stderr.buffer.flush()\nwhile True:\n sys.stdout.buffer.write(b'abcdefghijkl'); sys.stdout.buffer.flush(); time.sleep(.02)\n",
+        );
+        rig.state.active.store(true, Ordering::SeqCst);
+        rig.wait(|| rig.frames() >= 2);
+        assert_eq!(rig.launches(), 1);
+        let start = Instant::now();
+        drop(rig);
+        assert!(start.elapsed() < Duration::from_secs(1));
+    }
+
+    #[test]
+    fn vendor_stdout_between_pixel_writes_cannot_pollute_the_frame_pipe() {
+        let rig = Rig::with_frame_pipe(
+            "sys.stdout.write('[ISP] startup banner\\n'); sys.stdout.flush()\nwhile True:\n os.write(3,b'abcdef'); os.write(1,b'[ISP] diagnostic between pixels\\n'); os.write(3,b'ghijkl'); time.sleep(.02)\n",
+            true,
+        );
+        rig.state.active.store(true, Ordering::SeqCst);
+        // FakeConsumer checks every exact 12-byte frame, including both halves around printf.
+        rig.wait(|| rig.frames() >= 4);
+        assert_eq!(rig.launches(), 1);
+    }
+}
