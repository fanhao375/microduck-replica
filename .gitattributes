# 二进制文件必须声明，否则在 core.autocrlf=true 的 Windows 上
# clone / checkout 时会被做 LF→CRLF 转换，文件直接损坏。
# git 的自动二进制探测靠采样前几 KB 有无 NUL 字节，对 PDF 这类
# 头部多为 ASCII 的格式会误判成文本。

# 三维与制造
*.stl   binary
*.stp   binary
*.step  binary
*.STEP  binary
*.3mf   binary
*.gbr   binary

# 图像
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.mp4   binary
*.webp  binary
*.ico   binary

# 文档与打包
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.xlsx  binary
*.docx  binary

# EDA 工程
*.eprj2 binary
*.epro2 binary
*.sh text eol=lf
# systemd 单元直接拷到主板用，CRLF 会让 systemd 读错
*.service text eol=lf
*.ps1 text eol=crlf
# 鸭子上直接执行、或由 systemd / sudo / sshd / NetworkManager 读的文件：一律 LF。
# 没后缀的脚本（#!/usr/bin/python3）、sudoers、*.conf 变成 CRLF 开机就会坏，
# 复刻镜像构建脚本也会拒绝带 CR 的 overlay（见 software/image/README.md）。
software/image/overlay/**        text eol=lf
software/image/calib/**          text eol=lf
software/image/tests/fixtures/** text eol=lf
software/studio/deploy/**        text eol=lf
software/studio/run.py           text eol=lf

# A7Z Python, shell, systemd and patch sources are installed on Linux.
radxa-cubie-a7z/** text eol=lf
