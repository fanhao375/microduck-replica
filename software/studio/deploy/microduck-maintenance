#!/usr/bin/python3
"""Fixed-scope maintenance helper. No user-selected paths or shell commands."""

from contextlib import contextmanager
import datetime
import hashlib
import io
import json
import os
import pathlib
import re
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
import zipfile

STATE = pathlib.Path("/var/lib/microduck-studio")
ROOT = pathlib.Path("/opt/microduck/software/current/studio")
CONFIG = {}
for p in [
    "/etc/robot/feetech-ft5/hd1910-calibration.toml",
    "/etc/robot/feetech-ft5/hd1910-calibration.saved.toml",
    "/etc/robot/feetech-ft5/robotd.toml",
    "/etc/robot/robotd.toml",
    "/var/lib/padd/mappings.json",
    "/etc/robot/feetech-ft5/pad-settings.json",
]:
    CONFIG["config/" + p.lstrip("/")] = pathlib.Path(p)
for n in [
    "servo-centered.json",
    "servo-directions.json",
    "imu-pending.json",
    "ai-connections.json",
    "battery-settings.json",
    "onboarding.json",
]:
    CONFIG["config/var/lib/microduck-studio/" + n] = STATE / n
CAMERA = "config/boot/radxa-camera-8m-local.dtbo"
TOF = "config/etc/systemd/system/tofd.service.d/60-local-vl53l5cx.conf"
TOF_TEXT = "[Service]\nExecStart=\nExecStart=/opt/robot/daemon/current/bin/tofd --bus /dev/i2c-3 --address 0x29 --no-imu\n"
CONFIG[CAMERA] = pathlib.Path("/boot/radxa-camera-8m-local.dtbo")
CONFIG[TOF] = pathlib.Path("/etc/systemd/system/tofd.service.d/60-local-vl53l5cx.conf")
MAX = 16 * 1024 * 1024


def read_config(path):
    # State directories are writable by service accounts. Pin the file and refuse
    # links and devices before a privileged read, including during restore backup.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size > 1024 * 1024:
            raise ValueError("配置文件的类型或大小不符合要求：" + path.name)
        data = stream.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise ValueError("配置文件过大")
        return data, st


def rpc(method):
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(5)
        s.connect("/run/robotd.sock")
        s.sendall(
            (
                json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": {}}) + "\n"
            ).encode()
        )
        with s.makefile("rb") as reply:
            line = reply.readline(4 * 1024 * 1024 + 1)
        if len(line) > 4 * 1024 * 1024 or not line.endswith(b"\n"):
            raise ValueError("主程序状态回复不完整")
        r = json.loads(line)
        if "error" in r:
            raise ValueError("主程序未接受操作：" + str(r["error"].get("message", ""))[:200])
        return r["result"]


def atomic(p, data, mode=0o600, owner=None):
    p.parent.mkdir(parents=True, exist_ok=True)
    fd, n = tempfile.mkstemp(prefix=".maintenance-", dir=p.parent)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fchmod(f.fileno(), mode)
            if owner:
                os.fchown(f.fileno(), *owner)
            os.fsync(f.fileno())
        os.replace(n, p)
        d = os.open(p.parent, os.O_RDONLY)
        os.fsync(d)
        os.close(d)
    finally:
        if os.path.exists(n):
            os.unlink(n)


def parse_config(name, data):
    if len(data) > 1024 * 1024:
        raise ValueError("单份配置过大")
    if name == CAMERA:
        if len(data) < 40 or data[:4] != b"\xd0\x0d\xfe\xed":
            raise ValueError("相机设备树格式不正确")
        return
    if name == TOF:
        if data.decode().replace("\r\n", "\n") != TOF_TEXT:
            raise ValueError("ToF 启动配置不是受支持的硬件参数")
        return
    v = tomllib.loads(data.decode()) if name.endswith(".toml") else json.loads(data)
    if not isinstance(v, (dict, list)):
        raise ValueError("配置格式不正确")
    return v


def export():
    files = {}
    missing = []
    for name, p in CONFIG.items():
        if p.exists():
            d, _ = read_config(p)
            parse_config(name, d)
            files[name] = d
        else:
            missing.append(name)
    for sub in ["studio", "web"]:
        for p in (ROOT / sub).rglob("*"):
            rel = p.relative_to(ROOT)
            if "vendor" in rel.parts or "__pycache__" in rel.parts:
                continue
            if p.is_file() and p.suffix in [".py", ".js", ".css", ".html"]:
                d = p.read_bytes()
                if len(d) < 2 * 1024 * 1024:
                    files["source/" + str(rel).replace("\\", "/")] = d
    if sum(map(len, files.values())) > MAX:
        raise ValueError("备份超过大小限制")
    manifest = {
        "format": "microduck-backup/v1",
        "created": datetime.datetime.now().astimezone().isoformat(),
        "hostname": socket.gethostname(),
        "missing": missing,
        "files": {n: hashlib.sha256(d).hexdigest() for n, d in files.items()},
    }
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("manifest.json", json.dumps(manifest, ensure_ascii=False))
        for n, d in files.items():
            z.writestr(n, d)
    sys.stdout.buffer.write(buf.getvalue())


def keys_subset(new, old, path=""):
    # 恢复的 robotd.toml 只能是当前文件的子集：不允许备份凭空带进当前版本没有的配置项
    if isinstance(new, dict):
        if not isinstance(old, dict):
            raise ValueError("备份里的配置结构与当前不一致：" + path)
        for k, v in new.items():
            if k not in old:
                raise ValueError("备份含有当前版本没有的配置项：" + path + k)
            keys_subset(v, old[k], path + k + ".")
    elif isinstance(new, list):
        if not isinstance(old, list):
            raise ValueError("备份配置的数组结构与当前不一致：" + path)
        if any(isinstance(v, (dict, list)) for v in new):
            if len(new) != len(old):
                raise ValueError("备份配置的结构化数组与当前不一致：" + path)
            for i, v in enumerate(new):
                keys_subset(v, old[i], path + str(i) + ".")
    elif isinstance(old, (dict, list)):
        raise ValueError("备份配置的结构与当前不一致：" + path)


def prune_imports(keep=2):
    # 每次恢复前的旧配置里有 API Key：只留最近几份，其余删掉
    root = pathlib.Path("/var/backups")
    old = sorted(root.glob("microduck-import-*"), key=lambda p: p.name)[:-keep] if keep else []
    for p in old:
        shutil.rmtree(p, ignore_errors=True)


def load(data):
    if len(data) > MAX:
        raise ValueError("备份文件过大")
    z = zipfile.ZipFile(io.BytesIO(data))
    infos = z.infolist()
    names = [x.filename for x in infos]
    if len(names) != len(set(names)) or len(names) > 500 or sum(x.file_size for x in infos) > MAX:
        raise ValueError("备份包结构或解压大小不正确")
    for n in names:
        if n.startswith("/") or ".." in pathlib.PurePosixPath(n).parts or "\\" in n:
            raise ValueError("备份路径不正确")
    m = json.loads(z.read("manifest.json"))
    expected = m.get("files")
    if (
        m.get("format") != "microduck-backup/v1"
        or not isinstance(expected, dict)
        or set(names) != set(expected) | {"manifest.json"}
    ):
        raise ValueError("不是支持的鸭子备份文件")
    restore = {}
    skipped = []
    for n, h in expected.items():
        d = z.read(n)
        if hashlib.sha256(d).hexdigest() != h:
            raise ValueError("备份校验失败：" + n)
        if n == CAMERA:
            skipped.append(n)
            continue  # 相机设备树内核启动时加载，不通过网页恢复，只导出
        if n in CONFIG:
            v = parse_config(n, d)
            if n.endswith("robotd.toml"):
                if not CONFIG[n].exists():
                    raise ValueError("本机缺少可核对的 robotd.toml，无法恢复")
                original, _ = read_config(CONFIG[n])
                keys_subset(v, tomllib.loads(original.decode()))
            restore[n] = d
        elif not n.startswith("source/"):
            raise ValueError("备份包含不支持的配置")
    if not restore:
        raise ValueError("备份没有可恢复的配置")
    return m, restore, skipped


def off():
    b = rpc("robot.busStatus")
    if not isinstance(b, dict) or any(
        b.get(k)
        for k in (
            "policy_enabled",
            "policy_motion_enabled",
            "torque_off_pending",
            "power_pending",
            "home_recovery",
            "motion",
            "hold",
        )
    ):
        return False
    native = b.get("native", {})
    if not isinstance(native, dict):
        return False
    top = b.get("torque_state")
    confirmed = native.get("torque_state_confirmed")
    if b.get("mode") == "commissioning":
        return b.get("phase") == "ready" and top == "off" and confirmed is not True
    hd = native.get("hd1910")
    return (b.get("mode") == "motion" and b.get("phase") == "control"
            and b.get("policy_enabled") is False and top in (None, "off")
            and confirmed is False and isinstance(hd, dict)
            and hd.get("restore_pending") is False and hd.get("temporary_gains_applied") is False)


INPUT_SERVICES = ("padd.service", "gamesir-xboxd.service")
UPDATING = pathlib.Path("/run/microduck-updater/installing")


def systemctl(*args):
    subprocess.run(["/bin/systemctl", *args], check=True, stdout=subprocess.DEVNULL)


def unit_state(unit):
    proc = subprocess.run(["/bin/systemctl", "show", unit, "-p", "LoadState",
                           "-p", "ActiveState", "-p", "SubState"], capture_output=True, text=True)
    values = dict(line.split("=", 1) for line in proc.stdout.splitlines() if "=" in line)
    state = tuple(values.get(name) for name in ("LoadState", "ActiveState", "SubState"))
    if unit == "robotd.service" and state == ("loaded", "activating", "auto-restart"):
        return "retrying"
    if state == ("not-found", "inactive", "dead"):
        return "absent"
    if proc.returncode == 0 and state in (("loaded", "active", "running"),
                                         ("loaded", "inactive", "dead"), ("loaded", "failed", "failed")):
        return state[1]
    raise ValueError("控制服务状态未确认：" + unit)


def studio_ready():
    # The exclusive motion lock already blocks new Studio and voice commands.
    # Finish only after commands admitted before that lock have drained.
    with socket.socket(socket.AF_UNIX) as conn:
        conn.settimeout(3)
        conn.connect("/run/microduck-studio/update.sock")
        conn.sendall(b'{"op":"readiness"}\n')
        with conn.makefile("rb") as stream:
            reply = stream.readline(8193)
    if len(reply) > 8192 or not reply.endswith(b"\n") or json.loads(reply).get("ready") is not True:
        raise ValueError("网页控制、录制或标定仍在运行")


class RecoveryUnconfirmed(ValueError):
    """Configuration is back on disk but the old robotd was not verified."""


def verify_restarted(timeout=15):
    # On 1104 Type=exec returns before robotd parses its configuration.
    # Two affirmative RPC replies also permit a board awaiting its hardware.
    deadline = time.monotonic() + timeout
    good_since = None
    while True:
        try:
            bus = rpc("robot.busStatus")
            ready = (isinstance(bus, dict) and bus.get("mode") in ("motion", "commissioning")
                     and bus.get("phase") in ("configuring_bus", "waiting_for_bus", "control", "ready",
                                              "holding", "moving", "power_pending", "read_error",
                                              "stop_unconfirmed")
                     and unit_state("robotd.service") == "active")
        except (OSError, TypeError, KeyError, ValueError):
            ready = False
        now = time.monotonic()
        if ready and good_since is not None and now - good_since >= 0.5:
            return
        good_since = (good_since if good_since is not None else now) if ready else None
        if now >= deadline:
            raise ValueError("重启后主程序未能连续报告运行状态")
        time.sleep(0.25)


@contextmanager
def paused_inputs(poweroff):
    stopped = []
    submitted = False
    unsafe = False
    try:
        studio_ready()
        for unit in INPUT_SERVICES:
            if unit_state(unit) == "active":
                stopped.append(unit)
                systemctl("stop", unit)
        yield
        submitted = True
    except RecoveryUnconfirmed:
        unsafe = True
        raise
    finally:
        if stopped and not unsafe and not (poweroff and submitted):
            systemctl("start", *stopped)


def final_check():
    # An updater waiting on our lock may already have published its intent.
    if UPDATING.exists() or any(unit_state(u) == "active" for u in INPUT_SERVICES):
        raise ValueError("更新或手柄控制已启动，维护操作已取消")
    if not off():
        raise ValueError("主程序未确认卸力和临时增益恢复，维护操作已取消")


def new_metadata(name, path):
    if name == "config/var/lib/padd/mappings.json":
        import pwd
        account = pwd.getpwnam("padd")
        try:
            path.parent.mkdir(mode=0o700)
        except FileExistsError:
            pass
        else:
            os.chown(path.parent, account.pw_uid, account.pw_gid)
        info = path.parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != account.pw_uid or info.st_mode & 0o022:
            raise ValueError("手柄映射目录的身份或权限不正确")
        return 0o600, (account.pw_uid, account.pw_gid)
    if path.parent == STATE:
        info = STATE.stat()
        return 0o600, (info.st_uid, info.st_gid)
    if name.startswith("config/etc/robot/"):
        import grp
        return 0o644, (0, grp.getgrnam("robot").gr_gid)
    if name == TOF:
        return 0o644, (0, 0)
    raise ValueError("缺少恢复目标的权限配置")


def main():
    if len(sys.argv) != 2:
        raise ValueError("操作不正确")
    op = sys.argv[1]
    if op == "export":
        export()
        return
    if op in ["preview", "restore"]:
        m, files, skipped = load(sys.stdin.buffer.read(MAX + 1))
        if op == "preview":
            print(
                json.dumps(
                    {
                        "ok": True,
                        "created": m["created"],
                        "hostname": m.get("hostname"),
                        "files": list(files),
                        "skipped": skipped,
                        "reboot_required": False,
                        "source_included": any(n.startswith("source/") for n in m["files"]),
                    }
                )
            )
            return
        with paused_inputs(poweroff=False):
            if not off():
                raise ValueError("请先扶稳鸭子并卸力，再导入备份")
            b = pathlib.Path(
                tempfile.mkdtemp(
                    prefix="microduck-import-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S-"),
                    dir="/var/backups",
                )
            )
            originals = {}
            for n in files:
                p = CONFIG[n]
                try:
                    d, st = read_config(p)
                except FileNotFoundError:
                    continue
                originals[n] = (d, st)
                old = b / n
                old.parent.mkdir(parents=True, exist_ok=True)
                atomic(old, d)
            written = []
            interrupted_services = False
            try:
                for n, d in files.items():
                    p = CONFIG[n]
                    if n in originals:
                        st = originals[n][1]
                        owner = (st.st_uid, st.st_gid)
                        mode = stat.S_IMODE(st.st_mode) & 0o777
                    else:
                        mode, owner = new_metadata(n, p)
                    atomic(p, d, mode, owner)
                    written.append(n)
                os.sync()
                if TOF in files:
                    subprocess.run(["systemctl", "daemon-reload"], check=True)
                final_check()
                # This worker lives outside Studio. Wait for the *actual* robotd
                # restart, with both physical and software inputs still excluded.
                interrupted_services = True
                systemctl("restart", "robotd.service", *(["tofd.service"] if TOF in files else []))
                verify_restarted()
                systemctl("restart", "microduck-studio.service")
            except Exception:
                for n in reversed(written):
                    if n in originals:
                        d, st = originals[n]
                        atomic(CONFIG[n], d, stat.S_IMODE(st.st_mode) & 0o777, (st.st_uid, st.st_gid))
                    else:
                        CONFIG[n].unlink(missing_ok=True)
                if TOF in written:
                    subprocess.run(["systemctl", "daemon-reload"], check=False)
                os.sync()
                if interrupted_services:
                    # Config is back on disk. Reload it only from a confirmed safe
                    # state, or start the old config if robotd is already stopped.
                    try:
                        state = unit_state("robotd.service")
                        if state == "active":
                            final_check()
                        elif state not in ("inactive", "failed", "retrying"):
                            raise ValueError("主程序状态未知")
                        systemctl("restart", "robotd.service", *(["tofd.service"] if TOF in files else []))
                        verify_restarted()
                        systemctl("restart", "microduck-studio.service")
                    except Exception as recovery:
                        raise RecoveryUnconfirmed("原配置已写回，主程序恢复未确认。手柄仍暂停，请检查主程序日志。") from recovery
                raise
        try:
            prune_imports(2)
        except Exception:
            pass
        return {"ok": True, "backup": str(b), "restored": len(files), "skipped": skipped,
                "reboot_required": False}
    if op == "shutdown":
        with paused_inputs(poweroff=True):
            rpc("robot.stop")
            rpc("robot.relax")
            deadline = time.monotonic() + 8
            while not off():
                if time.monotonic() >= deadline:
                    raise ValueError("卸力或增益恢复未确认，尚未安排关机")
                time.sleep(0.1)
            os.sync()
            final_check()
            systemctl("--no-block", "poweroff")
        print(json.dumps({"ok": True, "scheduled": True}))
        return
    raise ValueError("操作不支持")


RESULTS = pathlib.Path("/var/lib/microduck-maintenance-results")


def restore_with_receipt():
    raw = sys.stdin.buffer.readline(34)
    if not re.fullmatch(b"[0-9a-f]{32}\n", raw):
        raise ValueError("缺少有效的恢复编号")
    request_id = raw[:-1].decode("ascii")
    RESULTS.mkdir(mode=0o755, exist_ok=True)
    RESULTS.chmod(0o755)  # web service can read receipts under a restrictive unit UMask
    target = RESULTS / (request_id + ".json")
    if target.exists():
        raise ValueError("这个恢复编号已经使用过，请读取原来的恢复结果")
    for old in sorted(RESULTS.glob("*.json"), key=lambda p: p.stat().st_mtime_ns)[:-19]:
        old.unlink()

    def save(phase, **values):
        receipt = {"id": request_id, "phase": phase, **values}
        atomic(target, json.dumps(receipt, ensure_ascii=False).encode(), 0o644)
        return receipt

    save("running")
    try:
        result = main()
    except Exception as exc:
        save("failed", ok=False, error=str(exc)[:300] if isinstance(exc, ValueError) else "恢复未完成，请查看维护日志")
        raise
    return save("completed", **result)


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["restore"]:
            print(json.dumps(restore_with_receipt()))
        else:
            main()
    except Exception as e:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": str(e)[:300]
                    if isinstance(e, ValueError)
                    else "维护操作失败，请检查备份格式或服务日志",
                }
            )
        )
        sys.exit(1)
