#!/usr/bin/python3
"""Microduck 配网守护：看 wlan0，连不上就开热点，并写 /run/microduck/net.json。

nmcli 都在 self.run_cmd 里；时间从 tick(now) 传进来，测试可以完全用假 runner / 假时钟。

时间常数（密码错了最快/最慢多久热点回来）：
- wlan0 真的存在、且 NetworkManager 报 30（disconnected）后，连续 45 秒没连上才开热点。
  tick 是 3 秒，所以最快约 45~48 秒。
- 例外：一个 WiFi 都没存过（新卡第一次开机），没有可等的，断网那一拍就开热点（10-21 新卡上热点约 2 分钟才出来）。
  查已保存的 WiFi 时 nmcli 出错，当成不知道，照旧等 45 秒。
- NetworkManager 报「正在连」时最多等 120 秒；超时后按「没连上」再等 45 秒。
- 反复连接 / 断开的旧网络共享连续离线窗口，累计 123 秒仍未连上就触发回退判定。
  网卡枚举、nmcli 调用和热点实际启动仍可能另外耗时，不是开机后广播可见的硬期限。
- 热点连续 5 分钟没有客户端才去试已保存的 WiFi；从最后一个客户端离开时算。
- 开热点失败、关热点失败或尝试 WiFi 失败后，60 秒再试。
- Studio 正在连 WiFi 的窗口文件必须未到 until，且 mtime 在 180 秒内；期间不插手。
  因此密码错了但 NetworkManager 很快报 disconnected 时，热点最快约 48 秒回来；
  如果它一直卡在 connecting，超过 120 秒就直接按没连上处理，约 121~123 秒
  （最长约 2 分 3 秒）开热点。wlan0 还没被 AIC8800 枚举出来时不开始计时。
"""
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

DEFAULT_ROOT = os.environ.get("MICRODUCK_ROOT", "/")

DEVICE = "wlan0"
HOTSPOT_NAME = "Microduck-Hotspot"
HOTSPOT_IP = "10.42.0.1"
DEFAULT_PSK = "microduck"
STATE_REL = "/run/microduck/net.json"
HOTSPOT_KEYFILE_REL = "/etc/NetworkManager/system-connections/Microduck-Hotspot.nmconnection"
STUDIO_CONNECTING_REL = "/run/microduck/studio-connecting.json"
FIRSTBOOT = "/usr/local/sbin/microduck-firstboot"

TICK_S = 3.0
NONE_NEED_S = 45.0
CONNECTING_MAX_S = 120.0
OFFLINE_MAX_S = CONNECTING_MAX_S + TICK_S
HOTSPOT_IDLE_S = 300.0
RETRY_S = 60.0
STUDIO_CONNECTING_FRESH_S = 180.0

CONNECTING_STATES = range(40, 91)


@dataclass
class Result:
    returncode: int = 0
    stdout: str = ""
    stderr: str = ""
    timed_out: bool = False


def _default_run(args, timeout=10):
    try:
        proc = subprocess.run(args, capture_output=True, text=True,
                              encoding="utf-8", errors="replace", timeout=timeout)
        return Result(proc.returncode, proc.stdout, proc.stderr)
    except FileNotFoundError as exc:
        return Result(127, "", str(exc))
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else ""
        err = exc.stderr if isinstance(exc.stderr, str) else ""
        return Result(124, out, err, timed_out=True)
    except OSError as exc:
        return Result(126, "", str(exc))


def one_line(text):
    return " | ".join(part.strip() for part in (text or "").splitlines() if part.strip())


def terse_split(line, maxsplit=-1):
    """按 nmcli -t 的规则按未转义的冒号切分，并去掉转义反斜杠。"""
    fields = []
    current = []
    escaped = False
    for char in line:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":" and (maxsplit < 0 or len(fields) < maxsplit):
            fields.append("".join(current))
            current = []
        else:
            current.append(char)
    if escaped:
        current.append("\\")
    fields.append("".join(current))
    return fields


def classify_device(output):
    state = None
    connection = ""
    for line in output.splitlines():
        parts = terse_split(line, 1)
        if len(parts) != 2:
            continue
        key, value = parts
        if key == "GENERAL.STATE":
            match = re.search(r"\b(\d+)\b", value)
            if match:
                state = int(match.group(1))
        elif key == "GENERAL.CONNECTION":
            connection = value.strip()
            if connection == "--":
                connection = ""
    if state is None or state < 30:
        return "unavailable"
    if state == 100:
        if connection == HOTSPOT_NAME:
            return "hotspot"
        if connection:
            return "wifi"
    if state is not None and state in CONNECTING_STATES:
        return "connecting"
    return "none"


def normalize_security(value):
    text = (value or "").strip()
    upper = text.upper()
    if not text or text == "--" or upper == "OPEN":
        return "open"
    if "WEP" in upper:
        return "wep"
    if "802.1X" in upper or "EAP" in upper:
        return "enterprise"
    if "WPA3" in upper or "SAE" in upper:
        return "wpa3_sae"
    if "WPA" in upper:
        return "wpa_psk"
    return "wpa_psk"


def parse_scan(output, saved_ssids):
    best = {}
    for line in output.splitlines():
        if not line.strip():
            continue
        parts = terse_split(line, 2)
        if len(parts) != 3:
            continue
        ssid, signal_text, security = parts
        if not ssid:
            continue
        try:
            signal = int(signal_text)
        except ValueError:
            signal = 0
        entry = {
            "ssid": ssid,
            "signal": signal,
            "security": normalize_security(security),
            "saved": ssid in saved_ssids,
        }
        old = best.get(ssid)
        if old is None or entry["signal"] > old["signal"]:
            best[ssid] = entry
    return sorted(best.values(), key=lambda item: (-item["signal"], item["ssid"]))


def _atomic_write(path, data, mode=0o644):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / (".%s.tmp.%d" % (path.name, os.getpid()))
    try:
        with open(tmp, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        try:
            os.chmod(tmp, mode)
        except OSError:
            pass
        os.replace(tmp, path)
    except BaseException:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise


class Netcheck:
    def __init__(self, root=DEFAULT_ROOT, *, run_cmd=None, now=None,
                 log_stream=None, state_path=None, keyfile=None):
        self.root = Path(root or "/")
        self.run_cmd = run_cmd
        self.now = now if now is not None else (lambda: time.time())
        self.out = log_stream if log_stream is not None else sys.stdout
        self.state_path = Path(state_path) if state_path else self.path(STATE_REL)
        self.keyfile = Path(keyfile) if keyfile else self.path(HOTSPOT_KEYFILE_REL)

        start = float(self.now())
        self.start_time = start
        self.last_tick = start
        self.clock_now = start
        self.mode = "none"
        self.mode_since = start
        self.prev_effective = "none"
        self.none_accum = 0.0
        self.connecting_since = None
        self.offline_since = None
        self.hotspot_retry_at = 0.0
        self.force_hotspot_until = 0.0
        self.wifi_try_at = 0.0
        self.last_client_at = None
        self._studio_logged_until = None

        self.scan = []
        self.scan_at = None
        self.last_written = None
        self.write_count = 0
        self._last_error = None
        self._last_error_at = -9999.0
        self._load_existing_state()

    def path(self, absolute):
        absolute = str(absolute)
        if absolute == "/":
            return self.root
        return self.root / absolute.lstrip("/")

    def log(self, message):
        print(message, file=self.out, flush=True)

    def _error(self, message):
        now = self.clock_now
        if message == self._last_error and now - self._last_error_at < 60.0:
            return
        self._last_error = message
        self._last_error_at = now
        self.log("错误：" + message)

    def _run(self, args, timeout):
        runner = self.run_cmd or _default_run
        try:
            return runner(list(args), timeout=timeout)
        except TypeError:
            return runner(list(args))
        except BaseException as exc:
            return Result(126, "", "%s: %s" % (type(exc).__name__, exc))

    def _nmcli(self, args, timeout):
        return self._run(["nmcli"] + list(args), timeout)

    def _load_existing_state(self):
        try:
            self.last_written = json.loads(self.state_path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            self.last_written = None

    # ---- 读 wlan0 ----

    def wlan_present(self):
        path = self.path("/sys/class/net/%s" % DEVICE)
        return path.exists() or path.is_symlink()

    def read_raw_mode(self):
        if not self.wlan_present():
            self._error("%s 还不存在（AIC8800 可能还没起来），先不累计没连上的时间" % DEVICE)
            return "unavailable"
        result = self._nmcli(["-t", "-f", "GENERAL.STATE,GENERAL.CONNECTION",
                              "device", "show", DEVICE], 10)
        if result.returncode != 0:
            self._error("nmcli device show %s 失败（%s）：%s" %
                        (DEVICE, result.returncode, one_line(result.stderr or result.stdout)))
            return "unavailable"
        return classify_device(result.stdout)

    def _enter_mode(self, mode, now):
        if mode != self.mode:
            old = self.mode
            self.mode = mode
            self.mode_since = float(now)
            if mode == "hotspot":
                self.last_client_at = None
            self.log("配网状态：%s -> %s" % (old, mode))

    # ---- 扫描和已保存 WiFi ----

    def _connection_rows(self):
        result = self._nmcli(["-t", "-f", "NAME,TYPE", "connection", "show"], 10)
        if result.returncode != 0:
            self._error("nmcli connection show 失败（%s）：%s" %
                        (result.returncode, one_line(result.stderr or result.stdout)))
            return []
        rows = []
        for line in result.stdout.splitlines():
            if not line.strip():
                continue
            parts = terse_split(line, 1)
            if len(parts) != 2:
                continue
            name, kind = parts
            rows.append((name, kind))
        return rows

    def _saved_ssid(self, name):
        result = self._nmcli(["-g", "802-11-wireless.ssid",
                              "connection", "show", "id", name], 10)
        if result.returncode != 0:
            self._error("nmcli 取已保存 WiFi 的 SSID 失败（%s，退出 %s）：%s" %
                        (name, result.returncode,
                         one_line(result.stderr or result.stdout)))
            return name
        lines = [line for line in result.stdout.splitlines() if line.strip()]
        if not lines:
            return name
        value = terse_split(lines[0], 0)[0]
        return name if not value or value == "--" else value

    def saved_wifi_names(self):
        return [name for name, kind in self._connection_rows()
                if kind == "802-11-wireless" and name != HOTSPOT_NAME]

    def has_saved_wifi(self):
        """存没存过家里的 WiFi（热点自己那条不算）：True / False；nmcli 出错回 None，当成不知道。"""
        result = self._nmcli(["-t", "-f", "NAME,TYPE", "connection", "show"], 10)
        if result.returncode != 0:
            return None
        for line in result.stdout.splitlines():
            parts = terse_split(line, 1)
            if len(parts) == 2 and parts[1] == "802-11-wireless" and parts[0] != HOTSPOT_NAME:
                return True
        return False

    def saved_ssids(self):
        ssids = set()
        for name in self.saved_wifi_names():
            value = self._saved_ssid(name)
            if value:
                ssids.add(value)
        return ssids

    def scan_wifi(self, now):
        result = self._nmcli(["-t", "-f", "SSID,SIGNAL,SECURITY",
                              "device", "wifi", "list", "--rescan", "yes"], 15)
        if result.returncode != 0:
            self._error("扫描 WiFi 失败（%s）：%s" %
                        (result.returncode, one_line(result.stderr or result.stdout)))
            return False
        saved = self.saved_ssids()
        self.scan = parse_scan(result.stdout, saved)
        self.scan_at = float(now)
        return True

    # ---- 热点 ----

    def _hotspot_values(self):
        ssid = None
        psk = None
        section = None
        try:
            text = self.keyfile.read_text(encoding="utf-8")
        except OSError:
            text = ""
        for raw in text.splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or line.startswith(";"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip()
                continue
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip()
            if section == "wifi" and key == "ssid":
                ssid = value
            elif section == "wifi-security" and key == "psk":
                psk = value
        return ssid, psk

    def hotspot_ssid(self):
        ssid, _ = self._hotspot_values()
        if ssid:
            return ssid
        host = self.hostname()
        suffix = host.split("-", 1)[1] if "-" in host else "????"
        return "Microduck-" + suffix

    def hotspot_psk(self):
        _, psk = self._hotspot_values()
        return psk or DEFAULT_PSK

    def hostname(self):
        try:
            for line in self.path("/etc/hostname").read_text(encoding="utf-8").splitlines():
                if line.strip():
                    return line.strip()
        except OSError:
            pass
        try:
            return socket.gethostname()
        except OSError:
            return "microduck"

    def _safe_write_state(self, now):
        try:
            return self.write_state(now)
        except Exception as exc:
            self._error("写 %s 失败：%s: %s" % (self.state_path, type(exc).__name__, exc))
            return False

    def _ensure_hotspot_connection(self):
        if any(name == HOTSPOT_NAME for name, _kind in self._connection_rows()):
            return True
        if not self.keyfile.is_file():
            self.log("NetworkManager 里没有 %s 连接，配置文件也不存在，先运行 microduck-firstboot --hotspot-only 重建" %
                     HOTSPOT_NAME)
            result = self._run([FIRSTBOOT, "--hotspot-only"], 30)
            if result.returncode != 0:
                self.log("重建热点连接失败（退出 %s）：%s" %
                         (result.returncode, one_line(result.stderr or result.stdout)))
                return False
        # keyfile may exist while NetworkManager has not loaded it. Preserve the
        # owner's SSID/password instead of regenerating and overwriting it.
        result = self._nmcli(["connection", "load", str(self.keyfile)], 10)
        if result.returncode != 0:
            self.log("加载热点连接失败（退出 %s）：%s" %
                     (result.returncode, one_line(result.stderr or result.stdout)))
            return False
        if not any(name == HOTSPOT_NAME for name, _kind in self._connection_rows()):
            self.log("加载热点后仍未读回 %s，暂不激活" % HOTSPOT_NAME)
            return False
        return True

    def open_hotspot(self, now):
        self.scan_wifi(now)
        self._safe_write_state(now)
        if not self._ensure_hotspot_connection():
            self.hotspot_retry_at = float(now) + RETRY_S
            return False
        result = self._nmcli(["connection", "up", HOTSPOT_NAME], 30)
        if result.returncode != 0:
            detail = one_line(result.stdout or result.stderr)
            self.log("开热点失败：nmcli connection up %s 退出 %s：%s；%d 秒后重试" %
                     (HOTSPOT_NAME, result.returncode, detail, int(RETRY_S)))
            self.hotspot_retry_at = float(now) + RETRY_S
            return False
        if self.read_raw_mode() != "hotspot":
            self.log("热点激活命令已返回，但 wlan0 尚未确认连接到 %s；%d 秒后重试" %
                     (HOTSPOT_NAME, int(RETRY_S)))
            self.hotspot_retry_at = float(now) + RETRY_S
            return False
        self.hotspot_retry_at = 0.0
        self.log("开热点：%s" % HOTSPOT_NAME)
        self._enter_mode("hotspot", now)
        self.force_hotspot_until = float(now) + 30.0
        self.prev_effective = "hotspot"
        return True

    def _poll_stations(self, now):
        result = self._run(["iw", "dev", DEVICE, "station", "dump"], 10)
        if result.returncode != 0:
            self._error("iw station dump 失败（%s）：%s" %
                        (result.returncode, one_line(result.stderr or result.stdout)))
            self.wifi_try_at = float(now) + RETRY_S
            return False
        if result.stdout.strip():
            if self.last_client_at is None:
                self.log("热点上看到客户端")
            self.last_client_at = float(now)
            return True
        return False

    def _last_client_text(self):
        if self.last_client_at is None:
            return "无记录（从开热点算）"
        return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(self.last_client_at))

    def maybe_close_hotspot(self, now):
        idle_from = self.mode_since if self.last_client_at is None else self.last_client_at
        if now - idle_from < HOTSPOT_IDLE_S:
            return False
        if now < self.wifi_try_at:
            return False
        saved = self.saved_wifi_names()
        if not saved:
            return False
        result = self._nmcli(["connection", "down", HOTSPOT_NAME], 10)
        if result.returncode != 0:
            self.log("关热点失败：nmcli connection down %s 退出 %s：%s" %
                     (HOTSPOT_NAME, result.returncode,
                      one_line(result.stderr or result.stdout)))
            self.wifi_try_at = float(now) + RETRY_S
            return False
        self.log("热点 5 分钟没人连（最后看到客户端：%s），关掉热点，让 NetworkManager 连已保存的 WiFi：%s" %
                 (self._last_client_text(), "、".join(saved)))
        self.force_hotspot_until = 0.0
        self.wifi_try_at = 0.0
        self.last_client_at = None
        self._enter_mode("none", now)
        self.none_accum = 0.0
        self.prev_effective = "none"
        self.last_tick = float(now)
        return True

    # ---- Studio 正在连 WiFi 的窗口 ----

    def studio_connecting(self, now):
        path = self.path(STUDIO_CONNECTING_REL)
        try:
            stat_info = path.stat()
        except FileNotFoundError:
            return None
        except OSError as exc:
            self._error("读 %s 失败：%s: %s" % (path, type(exc).__name__, exc))
            return None

        def drop(reason):
            try:
                path.unlink()
                self.log("清理 Studio 连接窗口文件（%s）：%s" % (reason, path))
            except OSError as exc:
                self._error("删除过期的 %s 失败：%s" % (path, exc))
            return None

        if abs(float(now) - stat_info.st_mtime) > STUDIO_CONNECTING_FRESH_S:
            return drop("mtime 超过 180 秒，防时钟乱跳")
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            return drop("内容读不了：%s" % exc)
        try:
            until = float(data["until"])
        except (KeyError, TypeError, ValueError):
            return drop("缺少 until")
        if float(now) >= until:
            return drop("已经过期")
        return until, str(data.get("ssid") or "")

    # ---- 状态文件 ----

    def state_dict(self):
        return {
            "mode": self.mode,
            "hotspot_ssid": self.hotspot_ssid(),
            "hotspot_ip": HOTSPOT_IP,
            "hotspot_psk": self.hotspot_psk(),
            "hostname": self.hostname(),
            "since": float(self.mode_since),
            "scan": self.scan,
            "scan_at": self.scan_at,
        }

    def write_state(self, now=None):
        data = self.state_dict()
        if data == self.last_written and self.state_path.exists():
            return False
        self.state_path.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(self.state_path.parent, 0o755)
        except OSError:
            pass
        payload = (json.dumps(data, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
        _atomic_write(self.state_path, payload, 0o644)
        if hasattr(os, "geteuid") and os.geteuid() == 0 and hasattr(os, "chown"):
            try:
                os.chown(self.state_path, 0, 0)
            except OSError:
                pass
        self.last_written = data
        self.write_count += 1
        return True

    # ---- 主状态机 ----

    def tick(self, now=None):
        now = float(self.now() if now is None else now)
        self.clock_now = now
        delta = max(0.0, now - self.last_tick)

        studio = self.studio_connecting(now)
        if studio is not None:
            until, ssid = studio
            if self._studio_logged_until != until:
                self.log("Studio 正在连 WiFi（SSID：%s，直到 %s）：这段时间 netcheck 不插手。" %
                         (ssid or "未写", time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(until))))
                self._studio_logged_until = until
            self.none_accum = 0.0
            self.connecting_since = None
            self.offline_since = None
            self.prev_effective = "studio"
            self._safe_write_state(now)
            self.last_tick = now
            return self.mode
        if self._studio_logged_until is not None:
            self.log("Studio 连接窗口已结束，netcheck 恢复检查。")
            self._studio_logged_until = None

        raw = self.read_raw_mode()

        if raw == "unavailable" and self.mode == "hotspot":
            # nmcli 暂时读不到网卡时不要把正在用的热点关掉；等它恢复再继续。
            self.none_accum = 0.0
            self.connecting_since = None
            self.offline_since = None
            self.prev_effective = "hotspot"
            self._safe_write_state(now)
            self.last_tick = now
            return self.mode

        if (raw in ("none", "connecting") and now < self.force_hotspot_until
                and self.mode == "hotspot"):
            raw = "hotspot"

        if raw in ("none", "connecting"):
            if self.offline_since is None:
                self.offline_since = now
        else:
            self.offline_since = None

        hung_connecting = False
        effective = raw
        if raw == "connecting":
            if self.connecting_since is None:
                self.connecting_since = now
            if now - self.connecting_since > CONNECTING_MAX_S:
                self.none_accum += now - self.connecting_since
                effective = "none"
                hung_connecting = True
                self.connecting_since = None
        else:
            self.connecting_since = None

        if effective == "unavailable":
            self.none_accum = 0.0
        elif effective == "none":
            if hung_connecting:
                pass
            elif self.prev_effective == "none":
                self.none_accum += delta
            elif self.prev_effective == "connecting":
                pass
            else:
                self.none_accum = 0.0
        elif effective == "connecting":
            # 正在连：45 秒计时暂停，不清零，也不能算进 45 秒。
            pass
        else:
            self.none_accum = 0.0

        # NetworkManager can repeatedly retry an unreachable saved SSID. Each
        # attempt is shorter than CONNECTING_MAX_S and disconnected intervals
        # need not accumulate 45 seconds. Bound the whole offline episode.
        if (effective in ("none", "connecting") and self.offline_since is not None
                and now - self.offline_since >= OFFLINE_MAX_S):
            effective = "none"
            self.none_accum = max(self.none_accum, NONE_NEED_S)

        public_mode = "none" if effective in ("connecting", "unavailable") else effective
        self._enter_mode(public_mode, now)

        need = NONE_NEED_S
        if (effective == "none" and self.mode == "none" and self.none_accum < NONE_NEED_S
                and now >= self.hotspot_retry_at and self.has_saved_wifi() is False):
            need = 0.0
            self.log("一个 WiFi 都没存过：不等 45 秒，马上开热点")
        if (effective == "none" and self.mode == "none" and
                self.none_accum >= need and now >= self.hotspot_retry_at):
            self.open_hotspot(now)

        if self.mode == "hotspot":
            self._poll_stations(now)
            self.maybe_close_hotspot(now)

        self.prev_effective = "hotspot" if self.mode == "hotspot" else effective
        self._safe_write_state(now)
        self.last_tick = now
        return self.mode

    def run_forever(self):
        while True:
            try:
                self.tick()
            except Exception as exc:
                self._error("检查配网状态出错：%s: %s" % (type(exc).__name__, exc))
            time.sleep(TICK_S)


def main(argv=None):
    netcheck = Netcheck()

    def stop(*_args):
        raise SystemExit(0)

    try:
        signal.signal(signal.SIGTERM, stop)
    except (AttributeError, ValueError):
        pass
    netcheck.run_forever()


if __name__ == "__main__":
    main()
